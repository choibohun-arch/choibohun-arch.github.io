<!doctype html>
<html lang="ko"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="strict-origin">
<meta name="theme-color" content="#0d0f12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="대시보드">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<title>대시보드</title>
<style>
:root{--bg:#0d0f12;--card:#171a1f;--line:#262a31;--fg:#e8eaed;--mut:#8b929c;--acc:#e82127;--ok:#3ecf8e;--warn:#f5a524;--blue:#4ea1ff}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.45 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",sans-serif}
main{max-width:640px;margin:0 auto;padding:calc(env(safe-area-inset-top) + 14px) 14px calc(env(safe-area-inset-bottom) + 30px)}
header{display:flex;justify-content:space-between;align-items:baseline;margin:4px 2px 12px}
h1{font-size:20px;margin:0}h1 small{font-size:12px;color:var(--mut);font-weight:400;margin-left:6px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 15px;margin-bottom:12px}
h2{font-size:13px;color:var(--mut);font-weight:600;margin:0 0 10px;letter-spacing:.02em}
.big{font-size:44px;font-weight:700;line-height:1}.big small{font-size:18px;color:var(--mut);font-weight:500}
.row{display:flex;gap:10px;flex-wrap:wrap}.kv{flex:1 1 30%;min-width:92px;background:#1d2127;border-radius:12px;padding:9px 10px}
.kv b{display:block;font-size:17px}.kv span{font-size:11.5px;color:var(--mut)}
.bar{height:10px;background:#262a31;border-radius:6px;overflow:hidden;margin:12px 0 4px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--ok),#7be3b5)}
.mut{color:var(--mut);font-size:12.5px}.warn{color:var(--warn)}
svg{width:100%;height:auto;display:block}table{width:100%;border-collapse:collapse;font-size:13px}td,th{padding:6px 4px;border-bottom:1px solid var(--line);text-align:left}th{color:var(--mut);font-weight:500}
td.n,th.n{text-align:right}.pill{display:inline-block;padding:2px 8px;border-radius:99px;background:#262a31;font-size:12px}
.pill.on{background:#123d2a;color:var(--ok)}.empty{color:var(--mut);font-size:13px;padding:8px 0}
footer{color:var(--mut);font-size:11.5px;text-align:center;margin-top:16px}

[hidden]{display:none!important}
#lock{min-height:80vh;display:flex;flex-direction:column;justify-content:center;max-width:360px;margin:0 auto}
#lock input[type=password]{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:#1d2127;color:var(--fg);font-size:17px;margin:10px 0}
#lock button,.btn{width:100%;padding:13px;border:0;border-radius:12px;background:var(--acc);color:#fff;font-size:16px;font-weight:600}
.btn.sec{background:#262a31;width:auto;padding:6px 12px;font-size:12px}
#lock label{color:var(--mut);font-size:13px;display:flex;gap:8px;align-items:center;margin:4px 0 14px}
#err{color:var(--warn);font-size:13px;min-height:18px;margin-top:8px}
#map{height:260px;border-radius:12px;overflow:hidden;background:#1d2127}
.tbl{overflow-x:auto}.tbl table{min-width:420px}
.sum{display:grid;grid-template-columns:1fr 1fr;gap:8px}.sum .kv{min-width:0}
</style></head><body><main>
<div id="lock"><h1 style="margin-bottom:6px">🔒 대시보드</h1><div class="mut">비밀번호를 입력하세요</div>
<form id="lf" autocomplete="on"><input type="text" name="username" value="dashboard" autocomplete="username" hidden>
<input id="pw" type="password" autocomplete="current-password" placeholder="비밀번호" required>
<label><input id="rem" type="checkbox"> 이 기기에서 기억하기</label>
<button id="go" type="submit">열기</button></form><div id="err"></div></div>
<div id="app" hidden>
<header><h1>모빌리티<small id="model"></small></h1><span class="mut" id="stale"></span></header>
<section class="card" id="summary"><h2>요약</h2></section>
<section class="card" id="status"><h2>현재 상태</h2></section>
<section class="card" id="loc"><h2>마지막 위치</h2></section>
<section class="card" id="battery"><h2>배터리 건강</h2></section>
<section class="card" id="driving"><h2>주행</h2></section>
<section class="card" id="trips"><h2>주행 기록</h2></section>
<section class="card" id="charging"><h2>충전 기록</h2></section>
<section class="card" id="tires"><h2>타이어 공기압</h2></section>
<section class="card" id="afterblow"><h2>애프터블로우 기록</h2></section>
<section class="card" id="software"><h2>소프트웨어</h2></section>
<footer>주행가능거리는 ideal range 기준 · 주행/충전 기록은 정기 조회 사이를 추정한 값입니다<br><span id="gen"></span><br><br><button class="btn sec" id="logout">이 기기에서 잠그기</button></footer>
</div></main>
<script>

"use strict";
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const f=(v,d=0)=>v==null||isNaN(v)?"–":Number(v).toLocaleString("ko-KR",{minimumFractionDigits:d,maximumFractionDigits:d});
const KST={timeZone:"Asia/Seoul"};
const dt=s=>{if(!s)return"–";const d=new Date(s);return d.toLocaleString("ko-KR",{...KST,month:"numeric",day:"numeric",hour:"2-digit",minute:"2-digit",hour12:false})};
const ago=s=>{const m=(Date.now()-new Date(s))/6e4;if(m<1)return"방금";if(m<60)return Math.round(m)+"분 전";if(m<1440)return Math.round(m/60)+"시간 전";return Math.round(m/1440)+"일 전"};
const CS={Disconnected:"연결 안 됨",Charging:"충전 중",Complete:"충전 완료",Stopped:"충전 중지",Starting:"충전 시작",NoPower:"전원 없음"};
const cs=s=>CS[s]||s||"–";
function set(id,html){const el=$(id);el.innerHTML=el.querySelector("h2").outerHTML+html}

// minimal SVG line chart: series=[{pts:[[x,y]],color}], x numeric
function line(series,{h=150,yfmt=v=>f(v),xfmt=null,ymin=null,ymax=null,ref=null}={}){
  const W=600,H=h,L=44,R=10,T=10,B=24,all=series.flatMap(s=>s.pts);if(!all.length)return'<div class="empty">데이터 없음</div>';
  let x0=Math.min(...all.map(p=>p[0])),x1=Math.max(...all.map(p=>p[0]));if(x0===x1){x0-=1;x1+=1}
  let ys=all.map(p=>p[1]);if(ref!=null)ys.push(ref.y);let y0=ymin??Math.min(...ys),y1=ymax??Math.max(...ys);if(y0===y1){y0-=1;y1+=1}const pad=(y1-y0)*.1;if(ymin==null)y0-=pad;if(ymax==null)y1+=pad;
  const X=x=>L+(x-x0)/(x1-x0)*(W-L-R),Y=y=>T+(1-(y-y0)/(y1-y0))*(H-T-B);
  let g="";for(let i=0;i<=3;i++){const v=y0+(y1-y0)*i/3;g+=`<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="#262a31"/><text x="${L-6}" y="${Y(v)+4}" fill="#8b929c" font-size="11" text-anchor="end">${yfmt(v)}</text>`}
  if(xfmt){g+=`<text x="${L}" y="${H-6}" fill="#8b929c" font-size="11">${xfmt(x0)}</text><text x="${W-R}" y="${H-6}" fill="#8b929c" font-size="11" text-anchor="end">${xfmt(x1)}</text>`}
  if(ref)g+=`<line x1="${L}" x2="${W-R}" y1="${Y(ref.y)}" y2="${Y(ref.y)}" stroke="#8b929c" stroke-dasharray="4 4"/><text x="${W-R}" y="${Y(ref.y)-4}" fill="#8b929c" font-size="11" text-anchor="end">${esc(ref.label)}</text>`;
  for(const s of series){if(!s.pts.length)continue;const d=s.pts.map((p,i)=>(i?"L":"M")+X(p[0]).toFixed(1)+","+Y(p[1]).toFixed(1)).join("");
    g+=`<path d="${d}" fill="none" stroke="${s.color}" stroke-width="2.2" stroke-linejoin="round"/>`+s.pts.map(p=>`<circle cx="${X(p[0])}" cy="${Y(p[1])}" r="3" fill="${s.color}"/>`).join("")}
  return`<svg viewBox="0 0 ${W} ${H}">${g}</svg>`}
function bars(items,{h=140}={}){ // items [{label,v}]
  if(!items.length)return'<div class="empty">데이터 없음</div>';const W=600,H=h,L=34,B=22,T=14,max=Math.max(1,...items.map(i=>i.v)),bw=Math.min((W-L)/items.length,60);
  let g=`<text x="${L-6}" y="${T+4}" fill="#8b929c" font-size="11" text-anchor="end">${f(max)}</text><line x1="${L}" x2="${W}" y1="${H-B}" y2="${H-B}" stroke="#262a31"/>`;
  items.forEach((it,i)=>{const bh=(H-B-T)*it.v/max,x=L+i*bw;g+=`<rect x="${x+bw*.15}" y="${H-B-bh}" width="${bw*.7}" height="${Math.max(bh,it.v>0?1:0)}" rx="2" fill="#4ea1ff"/>`;
    if(items.length<=10||i%5===0||i===items.length-1)g+=`<text x="${x+bw/2}" y="${H-6}" fill="#8b929c" font-size="10.5" text-anchor="middle">${esc(it.label)}</text>`;
    if(items.length<=10&&it.v>0)g+=`<text x="${x+bw/2}" y="${H-B-bh-3}" fill="#e8eaed" font-size="11" text-anchor="middle">${f(it.v)}</text>`});
  return`<svg viewBox="0 0 ${W} ${H}">${g}</svg>`}
const md=t=>new Date(t).toLocaleDateString("ko-KR",{...KST,month:"numeric",day:"numeric"});


const dur=m=>m==null?"–":m<60?`${m}분`:`${Math.floor(m/60)}시간 ${m%60}분`;
const tm=s=>new Date(s).toLocaleTimeString("ko-KR",{...KST,hour:"2-digit",minute:"2-digit",hour12:false});
function render(D){

  $("model").textContent=`${D.car.model} · ${D.car.hw}`;
  const S=D.status||{};
  if(D.last_snapshot){const h=(Date.now()-new Date(D.last_snapshot))/36e5;$("stale").innerHTML=h>3?`<span class="warn">마지막 데이터 ${ago(D.last_snapshot)}</span>`:`업데이트 ${ago(D.last_snapshot)}`}
  const chg=S.charging_state&&S.charging_state!=="Disconnected";
  set("status",`<div style="display:flex;justify-content:space-between;align-items:flex-end">
   <div class="big">${f(S.soc)}<small>%</small></div><div style="text-align:right"><div class="big" style="font-size:30px">${f(S.ideal_range_km)}<small> km</small></div><div class="mut">예상 주행가능 (ideal)</div></div></div>
   <div class="bar"><i style="width:${Math.min(100,S.soc||0)}%"></i></div>
   <div class="mut" style="margin-bottom:10px">사용 가능 ${f(S.usable_soc)}%${S.charge_limit_soc?` · 충전 한도 ${f(S.charge_limit_soc)}%`:""}</div>
   <div class="row"><div class="kv"><span>실내</span><b>${S.inside_temp_c!=null?f(S.inside_temp_c,1)+"°":"–"}</b></div>
   <div class="kv"><span>실외</span><b>${S.outside_temp_c!=null?f(S.outside_temp_c,1)+"°":"–"}</b></div>
   <div class="kv"><span>충전</span><b><span class="pill ${chg?"on":""}">${esc(cs(S.charging_state))}</span></b></div></div>
   ${chg?`<div class="mut" style="margin-top:8px">${f(S.charger_power_kw)} kW · +${f(S.charge_energy_added_kwh,1)} kWh${S.minutes_to_full?` · 완충까지 ${f(S.minutes_to_full)}분`:""}</div>`:""}
   <div class="mut" style="margin-top:10px">마지막 업데이트: ${dt(S.updated)} KST · 누적 ${f(S.odometer_km)} km</div>`);

  const B=D.battery,pts=B.series.filter(p=>p.soc>=20).map(p=>[new Date(p.t).getTime(),p.full_km]);
  set("battery",`<div class="row"><div class="kv"><span>추정 완충 거리</span><b>${f(B.est_full_km)} km</b></div>
   <div class="kv"><span>신차 EPA 대비</span><b>${B.degradation_pct!=null?"−"+f(B.degradation_pct,1)+"%":"–"}</b></div>
   <div class="kv"><span>신차 EPA</span><b>${f(D.car.epa_km)} km</b></div></div>
   <div style="margin-top:10px">${line([{pts,color:"#3ecf8e"}],{xfmt:md,yfmt:v=>f(v)})}</div>
   <div class="mut">ideal range ÷ 사용가능 SoC 로 추정 (SoC 20% 이상 측정만). 측정 ${pts.length}회${pts.length<10?" — 아직 기록이 적어 추세는 참고용":""}</div>`);

  const Dr=D.driving,daily=Dr.daily.map(d=>({label:d.date.slice(5).replace("-","/"),v:d.km||0}));
  set("driving",`<div class="row"><div class="kv"><span>이번 달 (${esc(Dr.month)})</span><b>${f(Dr.month_km,1)} km</b></div>
   <div class="kv"><span>누적 주행</span><b>${f(Dr.odometer_km)} km</b></div></div>
   <div style="margin-top:10px">${bars(daily)}</div><div class="mut">최근 30일 일별 주행 거리 (기록된 날 기준, ${daily.length}일)</div>`);

  const PSI=14.5038,T=D.tires,tc={fl:"#4ea1ff",fr:"#3ecf8e",rl:"#f5a524",rr:"#e82127"},tn={fl:"앞 좌",fr:"앞 우",rl:"뒤 좌",rr:"뒤 우"};
  if(T.length){const last=T[T.length-1];
    set("tires",`<div class="row">${Object.keys(tn).map(k=>`<div class="kv" style="flex-basis:22%;min-width:70px"><span style="color:${tc[k]}">● ${tn[k]}</span><b>${last[k]!=null?f(last[k]*PSI,1)+" psi":"–"}</b></div>`).join("")}</div>
     <div style="margin-top:10px">${line(Object.keys(tn).map(k=>({color:tc[k],pts:T.filter(p=>p[k]!=null).map(p=>[new Date(p.t+"+09:00").getTime(),p[k]*PSI])})),{xfmt:md,yfmt:v=>f(v,1)})}</div><div class="mut">단위: psi (1 bar = 14.5038 psi)</div>`)}
  else set("tires",`<div class="empty">공기압 데이터 없음 (차량이 TPMS 값을 보고하지 않거나 아직 수집 전)</div>`);

  const A=D.afterblow;
  if(A&&typeof A==="object"){const rows=Array.isArray(A)?A:(A.log||A.history||A.events||null);
    if(Array.isArray(rows)&&rows.length)set("afterblow",`<table>${rows.slice(-15).reverse().map(r=>`<tr>${Object.values(r).slice(0,4).map(v=>`<td>${esc(typeof v==="string"&&/^\d{4}-\d\d-\d\dT/.test(v)?dt(v):typeof v==="object"?JSON.stringify(v):v)}</td>`).join("")}</tr>`).join("")}</table>`);
    else set("afterblow",`<table>${Object.entries(A).filter(([k,v])=>typeof v!=="object").map(([k,v])=>`<tr><th>${esc(k)}</th><td>${esc(typeof v==="string"&&/^\d{4}-\d\d-\d\dT/.test(v)?dt(v):v)}</td></tr>`).join("")}</table>`)}
  else set("afterblow",`<div class="empty">아직 기록 없음</div>`);

  const W=D.software;
  set("software",W?`<div class="row"><div class="kv"><span>현재 버전</span><b>${esc(W.version)}</b></div>
   <div class="kv"><span>업데이트</span><b>${W.update_status?esc(W.update_status)+(W.update_version?" "+esc(W.update_version):""):"없음"}</b></div></div><div class="mut" style="margin-top:8px">확인: ${dt(W.seen)} KST</div>`
   :`<div class="empty">아직 수집 전</div>`);
  renderExtra(D);
  $("gen").textContent=`기록: 대시보드 ${D.counts.history} · 배터리 ${D.counts.battery_health} · 충전감시 ${D.counts.charge_watch}건`;
}
function renderExtra(D){
  const M=D.summary||{};
  set("summary",`<div class="sum">
   <div class="kv"><span>이번 달 (${esc(M.month)})</span><b>${f(M.month_km,1)} km</b></div>
   <div class="kv"><span>누적 주행</span><b>${f(M.odometer_km)} km</b></div>
   <div class="kv"><span>주행 횟수 (이번 달/전체)</span><b>${f(M.trips_month)} / ${f(M.trips)}</b></div>
   <div class="kv"><span>충전 횟수</span><b>${f(M.charge_sessions)}</b></div>
   <div class="kv"><span>총 충전 시간</span><b>${M.charge_sessions?dur(M.charge_minutes):"–"}</b></div>
   <div class="kv"><span>총 충전 에너지</span><b>${M.charge_sessions?f(M.charge_kwh,1)+" kWh":"–"}</b></div>
   <div class="kv" style="grid-column:1/-1"><span>평균 전비 (추정)</span><b>${M.avg_wh_km!=null?f(M.avg_wh_km)+" Wh/km":"–"}</b></div></div>
   <div class="mut" style="margin-top:8px">기록 시작 ${dt(M.tracked_since)} · 기록 기간 주행 ${f(M.tracked_km,1)} km${M.avg_wh_km==null?" · 전비는 SoC 기록이 있는 주행이 10 km 이상 쌓이면 표시":` (기준 ${f(M.avg_basis_km,1)} km)`}</div>`);

  const L=D.location;
  if(L){set("loc",`<div id="map"></div><div class="mut" style="margin-top:8px">${dt(L.t)} KST 기준 · <a style="color:var(--blue)" href="https://www.openstreetmap.org/?mlat=${L.lat}&mlon=${L.lon}#map=16/${L.lat}/${L.lon}" target="_blank" rel="noreferrer">지도 앱에서 열기</a></div>`);loadMap(L)}
  else set("loc",`<div class="empty">아직 위치 기록 없음 (다음 정기 조회부터 표시)</div>`);

  const T=(D.trips||[]).slice().reverse();
  set("trips",T.length?`<div class="tbl"><table><tr><th>날짜</th><th>시간(대략)</th><th class="n">거리</th><th class="n">SoC</th><th class="n">kWh</th></tr>${T.slice(0,40).map(t=>`<tr><td>${md(t.start)}</td><td>${tm(t.start)}~${tm(t.end)}${t.ongoing?" 🚗":""}<br><span class="mut">≤${dur(t.minutes)}</span></td><td class="n">${f(t.km,1)} km</td><td class="n">${t.soc_used!=null?"−"+f(t.soc_used)+"%":"–"}</td><td class="n">${t.kwh_est!=null?"~"+f(t.kwh_est,1):"–"}${t.wh_km?`<br><span class="mut">${f(t.wh_km)} Wh/km</span>`:""}</td></tr>`).join("")}</table></div>
   <div class="mut" style="margin-top:6px">조회 사이 주행거리 증가로 감지 · 시간은 앞뒤 조회 시각 · kWh = SoC × 추정 용량 ${f(D.car.cap_kwh_est,1)} kWh</div>`
   :`<div class="empty">아직 감지된 주행 없음</div>`);

  const C=D.charging,ses=(C.sessions||[]).slice().reverse(),tl=(C.timeline||[]).map(p=>[new Date(p.t).getTime(),p.soc]);
  set("charging",`${line([{pts:tl,color:"#4ea1ff"}],{h:120,xfmt:md,yfmt:v=>f(v)+"%",ymin:0,ymax:100})}<div class="mut" style="margin-bottom:8px">SoC 추이</div>
   ${ses.length?`<div class="tbl"><table><tr><th>시작</th><th>종료</th><th class="n">시간</th><th class="n">SoC</th><th class="n">에너지</th></tr>${ses.map(s=>`<tr><td>${dt(s.start)}${s.approx?"*":""}</td><td>${s.ongoing?"충전 중":dt(s.end)}</td><td class="n">${dur(s.minutes)}</td><td class="n">${f(s.soc_start)}→${f(s.soc_end)}%<br><span class="mut">+${f(s.soc_added)}%</span></td><td class="n">${f(s.kwh,1)} kWh</td></tr>`).join("")}</table></div>${ses.some(s=>s.approx)?'<div class="mut">* 조회 사이에 충전이 끝나 시간은 대략값</div>':""}`
   :`<div class="empty">기록 기간 중 충전 세션 없음</div>`}`);
}
let mapLoaded=null;
function loadMap(L){
  const go=()=>{const m=window.L.map("map",{attributionControl:true}).setView([L.lat,L.lon],15);
    window.L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap"}).addTo(m);
    window.L.circleMarker([L.lat,L.lon],{radius:9,color:"#fff",weight:2,fillColor:"#e82127",fillOpacity:1}).addTo(m)};
  if(window.L)return go();
  const c=document.createElement("link");c.rel="stylesheet";c.href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";c.integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H";c.crossOrigin="anonymous";document.head.appendChild(c);
  const s=document.createElement("script");s.src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";s.integrity="sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH";s.crossOrigin="anonymous";s.onload=go;
  s.onerror=()=>{$("map").innerHTML='<div class="empty" style="padding:12px">지도를 불러오지 못했습니다</div>'};document.head.appendChild(s);
}
// ---------- decryption ----------
const LS="dash.k1",b64=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0)),tob64=b=>btoa(String.fromCharCode(...new Uint8Array(b)));
let BLOB=null;
async function blob(){if(!BLOB)BLOB=await (await fetch("data.enc.json?"+Date.now(),{cache:"no-store"})).json();return BLOB}
async function derive(pw,B){const base=await crypto.subtle.importKey("raw",new TextEncoder().encode(pw),"PBKDF2",false,["deriveKey"]);
  return crypto.subtle.deriveKey({name:"PBKDF2",hash:"SHA-256",salt:b64(B.salt),iterations:B.iter},base,{name:"AES-GCM",length:256},true,["decrypt"])}
async function dec(key,B){const pt=await crypto.subtle.decrypt({name:"AES-GCM",iv:b64(B.iv)},key,b64(B.ct));return JSON.parse(new TextDecoder().decode(pt))}
function show(D){$("lock").hidden=true;$("app").hidden=false;render(D)}
async function tryStored(){try{const st=JSON.parse(localStorage.getItem(LS)||"null");if(!st)return false;const B=await blob();
  if(st.salt!==B.salt||st.iter!==B.iter){localStorage.removeItem(LS);return false}
  const key=await crypto.subtle.importKey("raw",b64(st.k),{name:"AES-GCM"},false,["decrypt"]);show(await dec(key,B));return true}catch(e){localStorage.removeItem(LS);return false}}
$("lf").addEventListener("submit",async ev=>{ev.preventDefault();$("err").textContent="확인 중…";$("go").disabled=true;
  try{const B=await blob(),key=await derive($("pw").value,B),D=await dec(key,B);
    if($("rem").checked)localStorage.setItem(LS,JSON.stringify({k:tob64(await crypto.subtle.exportKey("raw",key)),salt:B.salt,iter:B.iter}));
    $("pw").value="";$("err").textContent="";show(D)}
  catch(e){$("err").textContent=(e&&e.name==="OperationError")?"비밀번호가 올바르지 않습니다":"불러오기 실패: "+(e&&e.message||e)}
  finally{$("go").disabled=false}});
$("logout").addEventListener("click",()=>{localStorage.removeItem(LS);location.reload()});
if(!window.crypto||!crypto.subtle)$("err").textContent="이 브라우저는 암호 해제를 지원하지 않습니다 (HTTPS 필요)";else tryStored();
</script></body></html>
